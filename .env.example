ERM_ADMIN_TOKEN=
# ERA Bridge / CIRI 调用（必填于 production）
ERA_BRIDGE_TOKEN=
ERM_SECRET_KEY=
ERA_BRIDGE_NOTIFY_URL=
# 禁止 URL ?token= 传管理员口令（仅调试可开）
ERM_ALLOW_QUERY_TOKEN=
ERM_LOGIN_MAX_ATTEMPTS=12
ERM_LOGIN_WINDOW_SECONDS=900
ERM_LOGIN_LOCKOUT_SECONDS=600
ERM_OCR_ENGINE=rapidocr
ERM_SCHEDULER_INTERVAL=60

# E1 身份：production 默认开启。本地可用 ERM_AUTH_MODE=off 关闭。
ERM_AUTH_MODE=
ERM_ADMIN_USER=admin
ERM_ADMIN_PASSWORD=
ERM_DIRECTOR_USER=
ERM_DIRECTOR_PASSWORD=
# 可选：复用 EnterpriseRiskAI JWT
ERM_JWT_SECRET=
JWT_SECRET_KEY=

# 密钥禁止写入页面，仅环境变量
ERM_SMTP_HOST=
ERM_SMTP_PORT=587
ERM_SMTP_USER=
ERM_SMTP_PASSWORD=
ERM_SMTP_FROM=
ERM_FCM_SERVER_KEY=
ERM_OAUTH_GENERIC_SECRET=
ERM_OAUTH_CLIENT_SECRET=

# E2 持久化：PostgreSQL 为主存储；MinIO 存导出/证据
ERM_DATABASE_URL=
DATABASE_URL=
ERM_MINIO_ENDPOINT=
ERM_MINIO_ACCESS_KEY=
ERM_MINIO_SECRET_KEY=
ERM_MINIO_BUCKET=erm
ERM_MINIO_SECURE=0

# C5 外部信用/司法：demo=内置证据库；tianyancha / qichacha / http=商业或自建网关
ERM_EXTERNAL_RISK_PROVIDER=demo
ERM_EXTERNAL_RISK_URL=http://127.0.0.1:8091/api/external-risk/demo-feed
# 配置后评估自动拉取工商/司法证据（见 data_external_risk.py）
TIANYANCHA_TOKEN=
# 可选：强制 demo_fixture | tianyancha | none
ERM_EXTERNAL_RISK_PROVIDER=
QICHACHA_KEY=
QICHACHA_SECRET=

