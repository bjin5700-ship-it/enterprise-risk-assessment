# 企业风险动态评估系统 — 生产环境变量示例
# 复制为 web_app/.env 或在系统中设置同名环境变量

# 必填：客户访问的完整地址（含 https）
ERM_PUBLIC_URL=https://erm.yourcompany.com

# 生产模式
ERM_ENV=production

# 应用监听（内网，由 Nginx 反代时可保持 8088）
ERM_HOST=0.0.0.0
ERM_PORT=8088

# 会话密钥（生产环境请改为随机长字符串）
ERM_SECRET_KEY=请替换为随机32位以上字符串

# Waitress 工作线程数
ERM_THREADS=8

# 定时同步检查间隔（秒）
ERM_SCHEDULER_INTERVAL=60

# 可选：禁用内置调度器（若单独部署 cron）
# ERM_DISABLE_SCHEDULER=1
