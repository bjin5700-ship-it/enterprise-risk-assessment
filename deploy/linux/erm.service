[Unit]
Description=Enterprise Risk Management Web App
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/erm/web_app
EnvironmentFile=-/opt/erm/web_app/.env
Environment=ERM_ENV=production
Environment=ERM_HOST=0.0.0.0
Environment=ERM_PORT=8088
ExecStart=/opt/erm/.venv/bin/gunicorn -w 1 -b 0.0.0.0:8088 --timeout 120 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
